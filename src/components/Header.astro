---
import profilePic from "../../content/assets/nick-ang-profile-photo-square-jun-2018-min.jpg";
import { topicPages } from "../lib/topics";

const topics = topicPages.map((topic) => ({
  label: topic.title,
  path: topic.basePath,
}));

const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="accent" transition:name="sidebar-accent" transition:persist></div>
  <div class="header-inner">
    <a href="/" class="title-link">
      <img
        src={profilePic.src}
        alt="Nick Ang profile picture"
        class="avatar"
        width="68"
        height="68"
        transition:name="site-avatar"
        transition:persist
      />
      <span class="site-title">Nick Ang</span>
    </a>

    <form
      action="/search"
      method="GET"
      class="search-form"
    >
      <label for="sidebar-search" class="search-label">
        Search
      </label>
      <div class="search-input-wrap">
        <input
          id="sidebar-search"
          class="search-input"
          type="text"
          name="q"
          aria-label="Search the blog"
        />
        <button class="search-button" type="submit" aria-label="Search">
          <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5Zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14Z" />
          </svg>
        </button>
      </div>
    </form>

    <nav aria-label="Main navigation">
      <ul class="nav-list">
        <li class="nav-item">
          <a href="/" class:list={["nav-link", { active: currentPath === "/" }]}> 
            Blog
          </a>
        </li>
        <li class="nav-item">
          <a href="/projects" class:list={["nav-link", { active: currentPath.startsWith("/projects") }]}> 
            Projects
          </a>
        </li>
      </ul>
    </nav>

    <section class="sidebar-section">
      <h2 class="sidebar-heading">Topics</h2>
      <ul class="sidebar-list">
        {topics.map(topic => (
          <li class="sidebar-item">
            <a
              href={topic.path}
              class:list={["sidebar-link", { active: currentPath.startsWith(topic.path) }]}
            >
              {topic.label}
            </a>
          </li>
        ))}
      </ul>
    </section>


    <form
      name="subscribe"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="subscribe-form"
    >
      <input type="hidden" name="form-name" value="subscribe" />
      <p hidden>
        <label>
          Don't fill this out if you're human: <input name="bot-field" />
        </label>
      </p>
      <label for="sidebar-email" class="subscribe-label">
        Subscribe
      </label>
      <input
        id="sidebar-email"
        class="subscribe-input"
        type="email"
        name="email"
        placeholder="bob@email.com"
        required
      />
      <button class="subscribe-button" type="submit">
        Sign Up
      </button>
    </form>

    <section class="sidebar-section">
      <h2 class="sidebar-heading">Socials</h2>
      <ul class="social-list">
        <li class="social-item">
          <a class="social-link" href="https://github.com/nickangtc/nickang-blog" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
            <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.16c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.16 1.18.92-.26 1.9-.38 2.88-.39.98 0 1.96.13 2.88.39 2.19-1.49 3.15-1.18 3.15-1.18.63 1.58.23 2.75.11 3.04.74.8 1.19 1.83 1.19 3.08 0 4.42-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.13v3.17c0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
            </svg>
          </a>
        </li>
        <li class="social-item">
          <a class="social-link" href="https://x.com/nickang" aria-label="X (Twitter)" target="_blank" rel="noopener noreferrer">
            <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M13.96 10.47 22.12 1h-1.93l-7.09 8.23L7.44 1H.92l8.55 12.44L.92 23h1.93l7.48-8.69L16.31 23h6.52l-8.87-12.53Zm-2.65 3.08-.87-1.24L3.55 2.45h2.96l5.57 7.97.87 1.24 7.24 10.36h-2.96l-5.92-8.47Z" />
            </svg>
          </a>
        </li>
        <li class="social-item">
          <a class="social-link" href="https://www.linkedin.com/in/nickangtc/" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
            <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.61 0 4.27 2.37 4.27 5.46v6.28ZM5.32 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.02H3.54V9H7.1v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z" />
            </svg>
          </a>
        </li>
      </ul>
    </section>
  </div>
</header>

<style lang="scss">
  @use '../styles/variables' as *;

  $sidebar-border: #111;

  .header {
    width: $layout-sidebar-width;
    min-width: $layout-sidebar-width;
    border-right: $layout-sidebar-divider solid $sidebar-border;
    padding: 0;
    background: white;
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 10;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    font-family: $sans-serif;
  }

  .header :global(*) {
    font-family: inherit;
  }

  .header :global(a) {
    transition: none;
  }

  .header :global(a:hover) {
    box-shadow: none;
  }

  .accent {
    position: sticky;
    top: 0;
    z-index: 2;
    flex: 0 0 auto;
    height: $space-lg;
    background: linear-gradient(
      180deg,
      $blue 0%,
      $blue 50%,
      rgba($gray, 0.75) 50%,
      rgba($gray, 0.75) 100%
    );
  }

  .header-inner {
    padding: $space-md $space-lg;
    box-sizing: border-box;
    max-width: 100%;
    font-family: $sans-serif;
    font-size: calc($base-size * 0.8);
  }

  .title-link {
    color: inherit;
    display: inline-flex;
    align-items: center;
    gap: $space-xs;
    max-width: 100%;
    text-decoration: none;
    box-shadow: none;
  }

  .site-title {
    margin: 0;
    min-width: 0;
    font-size: calc($base-size * 1.15);
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  .avatar {
    width: 52px;
    height: 52px;
    border-radius: 999px;
    flex: 0 0 auto;
    transform: scaleX(-1);
  }

  .nav-list {
    list-style: none;
    padding: 0;
    margin: $space-md 0 0;
  }

  .nav-item {
    margin-bottom: $space-xs;
  }

  .nav-link,
  .sidebar-link {
    position: relative;
    display: inline-block;
    text-decoration: none;
    box-shadow: none;
    color: black;
    font-size: calc($base-size * 0.88);
    z-index: 0;
  }

  .active {
    color: white;
    font-weight: inherit;

    &::before {
      content: "";
      position: absolute;
      left: -0.32em;
      right: -0.36em;
      top: -0.04em;
      bottom: -0.08em;
      background: $blue;
      clip-path: polygon(3% 8%, 100% 0, 96% 92%, 0 100%);
      transform: rotate(-1.5deg);
      z-index: -1;
    }
  }

  .sidebar-section {
    margin-top: $space-lg;
  }

  .sidebar-heading {
    margin: 0 0 $space-xxs;
    font-size: calc($base-size * 0.78);
    font-weight: 800;
    line-height: 1.1;
  }

  .sidebar-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-item {
    margin: 0 0 $space-xxs;
    line-height: 1.15;
  }

  .sidebar-link {
    font-size: calc($base-size * 0.78);
  }

  .social-list {
    display: flex;
    align-items: center;
    gap: $space-xs;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .social-item {
    margin: 0;
    line-height: 1;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.3rem;
    height: 1.3rem;
    color: black;
    box-shadow: none;
  }

  .social-icon {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }

  .search-form {
    display: flex;
    flex-wrap: wrap;
    margin: $space-lg 0 0;
    padding: 0;
    background: transparent;
  }

  .search-label {
    display: block;
    width: 100%;
    margin-bottom: 0.15rem;
    font-size: calc($base-size * 0.78);
    font-weight: 800;
  }

  .search-input-wrap {
    display: flex;
    width: 100%;
  }

  .search-input {
    flex: 1 1 auto;
    min-width: 0;
    box-sizing: border-box;
    margin: 0;
    padding: $space-xxs $space-xs;
    border: 1px solid black;
    border-right: 0;
    border-radius: 0.25rem 0 0 0.25rem;
    font-size: calc($base-size * 0.72);
    font-family: $sans-serif;
  }

  .search-input:focus {
    outline: none;
    border-color: $blue;
    box-shadow: inset 0 0 0 1px $blue;
  }

  .search-button {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: $space-xxs $space-xs;
    border: 1px solid black;
    border-radius: 0 0.25rem 0.25rem 0;
    background: black;
    color: white;
    cursor: pointer;
  }

  .search-button:hover {
    background: black;
    border-color: black;
    color: white;
  }

  .search-icon {
    width: 0.85rem;
    height: 0.85rem;
    fill: currentColor;
  }

  .subscribe-form {
    display: flex;
    flex-wrap: wrap;
    margin: $space-lg 0 0;
    padding: 0;
    background: transparent;
  }

  .subscribe-label {
    display: block;
    width: 100%;
    margin-bottom: 0.15rem;
    font-size: calc($base-size * 0.78);
    font-weight: 800;
  }

  .subscribe-input {
    flex: 1 1 auto;
    min-width: 0;
    box-sizing: border-box;
    margin: 0;
    padding: $space-xxs $space-xs;
    border: 1px solid black;
    border-right: 0;
    border-radius: 0.25rem 0 0 0.25rem;
    font-size: calc($base-size * 0.72);
  }

  .subscribe-input:focus {
    outline: none;
    border-color: $blue;
    box-shadow: inset 0 0 0 1px $blue;
  }

  .subscribe-button {
    flex: 0 0 auto;
    margin: 0;
    padding: $space-xxs $space-xs;
    border: 1px solid black;
    border-radius: 0 0.25rem 0.25rem 0;
    background: black;
    color: white;
    cursor: pointer;
    font-size: calc($base-size * 0.72);
    font-weight: 800;
    white-space: nowrap;
  }

  .subscribe-button:hover {
    background: black;
    border-color: black;
    color: white;
  }

  @media (max-width: 900px) {
    .header {
      width: 100%;
      min-width: 0;
      position: relative;
      top: auto;
      bottom: auto;
      left: auto;
      overflow-y: visible;
      border-right: none;
      border-bottom: $layout-sidebar-divider solid $sidebar-border;
    }

    .header-inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: $space-sm;
      padding: $space-md $space-lg;
    }

    .nav-list,
    .sidebar-section {
      display: none;
    }

    .search-form,
    .subscribe-form {
      width: 100%;
      margin-top: 0;
    }

    .subscribe-input,
    .subscribe-button {
      font-size: calc($base-size * 0.75);
    }
  }
</style>
