---
interface Props {
  class?: string;
}

const className = Astro.props.class || "";
---

<section class:list={["lightboxable-content", className]} data-lightbox>
  <slot />
</section>

<div class="overlay" id="lightbox-overlay" role="dialog" aria-modal="true" aria-label="Image preview">
  <button class="close-button" type="button" aria-label="Close image preview" id="lightbox-close">×</button>
  <img class="lightbox-image" id="lightbox-image" src="" alt="" />
</div>

<script>
  const MIN_LIGHTBOX_WIDTH = 768;
  const LIGHTBOX_ANIMATION_MS = 250;

  const lightboxState = window as Window & {
    __lightboxSetup?: boolean;
    __lightboxCloseTimer?: number;
  };

  function getLightboxElements() {
    return {
      overlayEl: document.getElementById("lightbox-overlay"),
      imageEl: document.getElementById("lightbox-image") as HTMLImageElement | null,
    };
  }

  function openLightbox(image: HTMLImageElement) {
    const { overlayEl, imageEl } = getLightboxElements();
    if (!overlayEl || !imageEl) return;

    if (lightboxState.__lightboxCloseTimer) {
      window.clearTimeout(lightboxState.__lightboxCloseTimer);
      lightboxState.__lightboxCloseTimer = undefined;
    }

    const wrapperLink = image.closest("a") as HTMLAnchorElement | null;
    imageEl.src = wrapperLink?.href || image.currentSrc || image.src;
    imageEl.alt = image.alt || "";
    overlayEl.classList.add("overlay-open");
    document.body.style.overflow = "hidden";
  }

  function closeLightbox() {
    const { overlayEl, imageEl } = getLightboxElements();
    if (!overlayEl || !imageEl) return;

    overlayEl.classList.remove("overlay-open");
    document.body.style.overflow = "";

    if (lightboxState.__lightboxCloseTimer) {
      window.clearTimeout(lightboxState.__lightboxCloseTimer);
    }

    lightboxState.__lightboxCloseTimer = window.setTimeout(() => {
      imageEl.src = "";
      lightboxState.__lightboxCloseTimer = undefined;
    }, LIGHTBOX_ANIMATION_MS);
  }

  function getLightboxImageFromEvent(event: Event) {
    const target = event.target as HTMLElement | null;
    return target?.closest("[data-lightbox] img") as HTMLImageElement | null;
  }

  function handleLightboxClick(event: MouseEvent) {
    if (window.innerWidth < MIN_LIGHTBOX_WIDTH) return;

    const image = getLightboxImageFromEvent(event);
    if (!image) return;

    event.preventDefault();
    openLightbox(image);
  }

  function handleLightboxKeydown(event: KeyboardEvent) {
    if (event.key === "Escape") {
      closeLightbox();
      return;
    }

    if (event.key !== "Enter" && event.key !== " ") return;

    const image = getLightboxImageFromEvent(event);
    if (!image) return;

    event.preventDefault();
    openLightbox(image);
  }

  function handleOverlayClick(event: MouseEvent) {
    const target = event.target as HTMLElement | null;
    if (target?.closest("#lightbox-close") || target?.id === "lightbox-overlay") {
      closeLightbox();
    }
  }

  function initLightbox() {
    if (lightboxState.__lightboxSetup) return;
    lightboxState.__lightboxSetup = true;

    document.addEventListener("click", handleLightboxClick);
    document.addEventListener("keydown", handleLightboxKeydown);
    document.addEventListener("click", handleOverlayClick);
  }

  initLightbox();
</script>

<style lang="scss">
  @use '../styles/variables' as *;

  @media (min-width: 768px) {
    .lightboxable-content :global(img) {
      cursor: zoom-in;
    }
  }

  .overlay {
    align-items: center;
    background: rgba(0, 0, 0, 0.86);
    bottom: 0;
    display: flex;
    justify-content: center;
    left: 0;
    opacity: 0;
    padding: $space-2xl;
    pointer-events: none;
    position: fixed;
    right: 0;
    top: 0;
    transition: opacity 0.25s ease-in-out, visibility 0.25s ease-in-out;
    visibility: hidden;
    z-index: 1000;
  }

  .overlay-open {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  .lightbox-image {
    cursor: zoom-out;
    max-height: 92vh;
    max-width: 92vw;
    object-fit: contain;
    transform: scale(0.985);
    transition: transform 0.25s ease-in-out;
  }

  .overlay-open .lightbox-image {
    transform: scale(1);
  }

  .close-button {
    background: transparent;
    border: 0;
    color: white;
    cursor: pointer;
    font-family: $sans-serif;
    font-size: $space-2xl;
    line-height: 1;
    padding: $space-sm;
    position: fixed;
    right: $space-lg;
    top: $space-md;
  }

  @media (max-width: 767px) {
    .overlay {
      display: none;
    }
  }
</style>
