---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import LightboxableContent from "../components/LightboxableContent.astro";
import { getPaginatedListConfig } from "../lib/pagination";

const allPosts = await getCollection("blog");

const blogPosts = allPosts
  // Keep this filter in sync with Previous/Next navigation in src/pages/[...slug].astro.
  // The blog detail nav should move through the same posts shown on this index.
  .filter((post) => {
    return (
      post.data.status !== "draft" &&
      !post.data.tags?.includes("Personal") &&
      !post.data.tags?.includes("Project")
    );
  })
  .sort(
    (a, b) =>
      new Date(b.data.date_published).getTime() -
      new Date(a.data.date_published).getTime()
  );

const config = getPaginatedListConfig(blogPosts.length, 0);
const initialPosts = blogPosts.slice(0, config.limit);
const hasMore = config.numPages > 1;
---

<BaseLayout title="Blog posts" pathname="/">
  <div class="view-controls">
    <button
      id="summary-toggle"
      class="summary-toggle"
      type="button"
      role="switch"
      aria-checked="false"
    >
      <span class="summary-toggle-track" aria-hidden="true">
        <span class="summary-toggle-knob"></span>
      </span>
      <span>Summarise</span>
    </button>
  </div>
  <LightboxableContent>
    <div id="post-list-container" data-blog-list-page>
      {initialPosts.map(async (post) => {
        const { Content } = await render(post);
        return (
          <article class="entry">
            <h1 class="article-title">
              <a href={`/${post.id}/`}>{post.data.title}</a>
            </h1>
            <section class="body post-full-content">
              <Content />
            </section>
            <section class="body post-summary" hidden>
              <p>{post.data.ai_summary}</p>
            </section>
            <hr class="divider" />
            <p class="meta">
              {new Date(post.data.date_published).toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </p>
          </article>
        );
      })}
    </div>
  </LightboxableContent>
  {hasMore && (
    <div id="infinite-trigger" data-next-page="2" data-base-path="" data-num-pages={config.numPages}>
      <p class="loading-status" id="loading-status"></p>
    </div>
  )}
</BaseLayout>

<script>
  function escapeHtml(str) {
    return str
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function initInfiniteScroll() {
    const trigger = document.getElementById("infinite-trigger");
    const container = document.getElementById("post-list-container");
    const statusEl = document.getElementById("loading-status");
    if (!trigger || !container) return;

    let isLoading = false;
    let nextPage = parseInt(trigger.dataset.nextPage || "2", 10);
    const numPages = parseInt(trigger.dataset.numPages || "1", 10);
    const basePath = trigger.dataset.basePath || "";

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries[0].isIntersecting || isLoading || nextPage > numPages) return;

        isLoading = true;
        if (statusEl) statusEl.textContent = "Loading more posts…";

        const jsonPath = basePath
          ? `/api/pages${basePath}/${nextPage}.json`
          : `/api/pages/${nextPage}.json`;

        fetch(jsonPath)
          .then((res) => {
            if (!res.ok) throw new Error("Failed to load");
            return res.json();
          })
          .then((data) => {
            const fragment = document.createDocumentFragment();
            for (const post of data.posts) {
              const article = document.createElement("article");
              const postHtml = post.html || "";
              const summary = post.ai_summary || "";
              article.className = "entry";
              article.innerHTML = `
                <h1 class="article-title"><a href="/${post.slug}/">${escapeHtml(post.title)}</a></h1>
                <section class="body post-full-content">${postHtml}</section>
                <section class="body post-summary" hidden><p>${escapeHtml(summary)}</p></section>
                <hr class="divider" />
                <p class="meta">${escapeHtml(post.date_published)}</p>
              `;
              fragment.appendChild(article);
            }
            container.appendChild(fragment);
            applySummaryMode();
            if (statusEl) statusEl.textContent = "";
            nextPage++;
            if (nextPage > numPages) {
              trigger.remove();
            }
          })
          .catch(() => {
            if (statusEl) statusEl.textContent = "Could not load more posts.";
          })
          .finally(() => {
            isLoading = false;
          });
      },
      { rootMargin: "600px 0px" }
    );

    observer.observe(trigger);
  }

  const SUMMARY_MODE_KEY = "blog-summary-mode";

  function isSummaryMode() {
    return localStorage.getItem(SUMMARY_MODE_KEY) === "true";
  }

  function applySummaryMode() {
    const summaryMode = isSummaryMode();
    const toggle = document.getElementById("summary-toggle");

    toggle?.setAttribute("aria-checked", String(summaryMode));
    document.querySelectorAll(".post-full-content").forEach((element) => {
      element.toggleAttribute("hidden", summaryMode);
    });
    document.querySelectorAll(".post-summary").forEach((element) => {
      element.toggleAttribute("hidden", !summaryMode);
    });
  }

  function initBlogIndex() {
    const toggle = document.getElementById("summary-toggle");
    if (!toggle || toggle.dataset.initialized === "true") return;

    toggle.dataset.initialized = "true";
    toggle.addEventListener("click", () => {
      localStorage.setItem(SUMMARY_MODE_KEY, String(!isSummaryMode()));
      applySummaryMode();
    });

    applySummaryMode();
    initInfiniteScroll();
  }

  initBlogIndex();
  document.addEventListener("astro:page-load", initBlogIndex);
</script>

<style lang="scss" is:global>
  @use '../styles/variables' as *;

  .entry {
    margin: 0 0 4rem;
  }

  .view-controls {
    display: flex;
    justify-content: flex-end;
    margin-bottom: $space-xl;
  }

  .summary-toggle {
    display: inline-flex;
    align-items: center;
    gap: $space-xs;
    padding: 0;
    border: 0;
    background: transparent;
    color: $darkgray;
    font-family: $sans-serif;
    font-size: 0.8 * $base-size;
    cursor: pointer;
  }

  .summary-toggle-track {
    position: relative;
    width: 2.1rem;
    height: 1.15rem;
    border: 1px solid $darkgray;
    border-radius: 999px;
    background: white;
    transition: background-color 0.15s ease;
  }

  .summary-toggle-knob {
    position: absolute;
    top: 0.14rem;
    left: 0.15rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: $darkgray;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }

  .summary-toggle[aria-checked="true"] .summary-toggle-track {
    border-color: $blue;
    background: $blue;
  }

  .summary-toggle[aria-checked="true"] .summary-toggle-knob {
    background: white;
    transform: translateX(0.95rem);
  }

  .summary-toggle:focus-visible {
    outline: 2px solid $blue;
    outline-offset: $space-xxs;
  }

  .article-title {
    margin-top: 0;
    margin-bottom: $space-xl;

    a {
      color: black;
      text-decoration: none;
      box-shadow: none;
    }
  }

  .meta {
    margin-top: 0;
    margin-bottom: $rhythm;
    font-family: $sans-serif;
    font-size: 0.75 * $base-size;
    font-weight: 700;
    text-transform: uppercase;
    color: $darkgray;
    letter-spacing: 0.02em;
  }

  .body {
    margin-bottom: 0;
  }

  .divider {
    margin: 0 0 $space-xxs;
    border: none;
    border-top: $layout-rule;
  }

  .loading-status {
    color: $darkgray;
    font-family: $sans-serif;
    font-size: 0.8 * $base-size;
    text-align: center;
  }

  #infinite-trigger {
    min-height: $space-2xl;
  }
</style>
