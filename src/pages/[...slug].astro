---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import LightboxableContent from "../components/LightboxableContent.astro";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const sorted = allPosts.sort(
    (a, b) =>
      new Date(b.data.date_published).getTime() -
      new Date(a.data.date_published).getTime()
  );
  // Keep this filter in sync with the main blog list in src/pages/index.astro.
  // Previous/Next should navigate through the same posts shown on the blog index.
  const postsInBlogNav = sorted.filter((post) => {
    return (
      post.data.status !== "draft" &&
      !post.data.tags?.includes("Personal") &&
      !post.data.tags?.includes("Project")
    );
  });

  return sorted.map((post) => {
    const blogNavIndex = postsInBlogNav.findIndex(
      blogPost => blogPost.id === post.id
    );
    const previousId =
      blogNavIndex !== -1 && blogNavIndex < postsInBlogNav.length - 1
        ? postsInBlogNav[blogNavIndex + 1].id
        : null;
    const nextId =
      blogNavIndex > 0
        ? postsInBlogNav[blogNavIndex - 1].id
        : null;

    return {
      params: { slug: post.id },
      props: { post, previousId, nextId },
    };
  });
}

const { post, previousId, nextId } = Astro.props;
const { Content } = await render(post);
const siteUrl = "https://nickang.com";
const postUrl = `${siteUrl}/${post.id}/`;
const description = post.data.excerpt || post.data.ai_summary;
const imageUrl = post.data.cover
  ? new URL(post.data.cover, siteUrl).href
  : `${siteUrl}/nickang-twitter-large-card.png`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description,
  ...(post.data.ai_summary ? { abstract: post.data.ai_summary } : {}),
  author: {
    "@type": "Person",
    name: "Nick Ang",
    url: siteUrl,
  },
  datePublished: post.data.date_published,
  ...(post.data.date_updated
    ? { dateModified: post.data.date_updated }
    : {}),
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": postUrl,
  },
  url: postUrl,
  image: imageUrl,
};

const datePublished = new Date(post.data.date_published).toLocaleDateString(
  "en-US",
  { year: "numeric", month: "long", day: "numeric" }
);
const dateUpdated = post.data.date_updated
  ? new Date(post.data.date_updated).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;

const datesLine =
  dateUpdated && dateUpdated !== datePublished
    ? `Published: ${datePublished} | Updated: ${dateUpdated}`
    : datePublished;
---

<BaseLayout
  title={post.data.title}
  description={description}
  pathname={`/${post.id}/`}
  openGraphType="article"
  structuredData={structuredData}
>
  <article data-post-scroll-restorable data-pagefind-body>
    <header>
      <h1 class="title">{post.data.title}</h1>
    </header>
    {post.data.status === "draft" && (
      <p>
        <strong>
          (This is a public <strong>draft</strong>. It can contain errors or
          problematic thinking. Read with a teaspoon of salt.)
        </strong>
      </p>
    )}
    {post.data.status === "revisit" && (
      <p>
        <strong>
          (This post has been marked for revisiting, likely because it needs a
          follow-up.)
        </strong>
      </p>
    )}
    {post.data.tags?.includes("Collection") && (
      <p>
        <strong>
          (This is a growing collection, so it's better to think of it as a wiki
          page. Check the updated date at the bottom of the article for the last
          date of update.)
        </strong>
      </p>
    )}
    {post.data.tags?.includes("Strictly 30") && (
      <p>
        <strong>
          (This post was written, edited, and published in under 30 minutes.{" "}
          <a href="/strictly-30">Learn more</a>.)
        </strong>
      </p>
    )}
    {post.data.ai_summary && (
      <details class="post-summary">
        <summary>Summary</summary>
        <p>{post.data.ai_summary}</p>
        <p class="ai-disclaimer">Note: this summary is generated with an LLM.</p>
      </details>
    )}
    <LightboxableContent>
      <Content />
    </LightboxableContent>
    {post.data.backlinks && post.data.backlinks.length > 0 && (
      <section class="backlinks-section">
        <p>📌 Posts that link to this one:</p>
        <ul>
          {post.data.backlinks.map((backlink) => (
            <li>
              <a href={backlink.slug}>{backlink.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <hr class="divider" />
    <time class="meta">{datesLine}</time>
  </article>

  <nav class="posts-nav" aria-label="Post navigation">
    {previousId && (
      <a class="post-nav-button" href={`/${previousId}/`} rel="prev" title="Arrow left">
        ← Previous
      </a>
    )}
    {nextId && (
      <a class="post-nav-button next" href={`/${nextId}/`} rel="next" title="Arrow right">
        Next →
      </a>
    )}
  </nav>
</BaseLayout>

<script>
  import { navigate } from "astro:transitions/client";

  const postPageState = window as Window & {
    __postScrollRestorationSetup?: boolean;
    __postSearchHighlightSetup?: boolean;
  };
  const storageKeyPrefix = "post-scroll-position:";
  let isRestoringScroll = false;
  let pendingScrollSave = 0;
  const highlightMarkClass = "search-highlight-mark";
  const highlightedTextSelector = "[data-search-highlighted-text]";
  const maxHighlightTerms = 8;
  const maxHighlightTermLength = 48;
  const searchHighlightSkipSelector = [
    "code",
    "pre",
    "kbd",
    "samp",
    "script",
    "style",
    "textarea",
    "input",
    "button",
    "select",
    "mark",
    "svg",
  ].join(",");

  function isPostPage() {
    return Boolean(document.querySelector("[data-post-scroll-restorable]"));
  }

  function getScrollStorageKey() {
    return `${storageKeyPrefix}${window.location.pathname}`;
  }

  function updateHistoryScrollRestoration() {
    if (!("scrollRestoration" in history)) return;

    // Only post detail pages use custom persistent scroll restoration.
    // Blog list pages keep browser/Astro defaults because new posts and
    // infinite loading can make saved pixel positions stale or misleading.
    history.scrollRestoration = isPostPage() ? "manual" : "auto";
  }

  function saveScrollPosition() {
    if (!isPostPage() || isRestoringScroll) return;

    try {
      localStorage.setItem(
        getScrollStorageKey(),
        JSON.stringify({ y: window.scrollY, savedAt: Date.now() })
      );
    } catch (_err) {
      // Ignore storage failures, e.g. private browsing quota restrictions.
    }
  }

  function scheduleScrollPositionSave() {
    if (pendingScrollSave) return;

    pendingScrollSave = window.requestAnimationFrame(() => {
      pendingScrollSave = 0;
      saveScrollPosition();
    });
  }

  function restoreScrollPosition() {
    if (!isPostPage()) return;

    let savedPosition;

    try {
      const rawSavedPosition = localStorage.getItem(getScrollStorageKey());
      if (!rawSavedPosition) return;

      savedPosition = JSON.parse(rawSavedPosition);
    } catch (_err) {
      return;
    }

    if (typeof savedPosition.y !== "number") return;

    isRestoringScroll = true;

    [0, 100, 300, 700].forEach(delay => {
      window.setTimeout(() => {
        window.scrollTo({ top: savedPosition.y, left: 0, behavior: "auto" });
      }, delay);
    });

    window.setTimeout(() => {
      isRestoringScroll = false;
    }, 800);
  }

  function escapeRegExp(value: string) {
    return value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  }

  function sanitizeSearchQuery(query: string | null) {
    if (!query) return null;

    const sanitized = query
      .replace(/[\u0000-\u001F\u007F<>&"'`]/g, " ")
      .replace(/\s+/g, " ")
      .trim()
      .slice(0, 120)
      .trim();

    return sanitized || null;
  }

  function getHighlightTerms() {
    const query = sanitizeSearchQuery(new URLSearchParams(window.location.search).get("q"));
    if (!query) return [];

    return Array.from(
      new Set(
        query
          .trim()
          .split(/\s+/)
          .slice(0, maxHighlightTerms)
          .map(term => term.trim().slice(0, maxHighlightTermLength))
          .filter(Boolean)
      )
    ).sort((a, b) => b.length - a.length);
  }

  function removeSearchHighlights() {
    document.querySelectorAll<HTMLElement>(`mark.${highlightMarkClass}`).forEach((mark) => {
      mark.replaceWith(document.createTextNode(mark.textContent ?? ""));
    });

    document.querySelectorAll<HTMLElement>(highlightedTextSelector).forEach((element) => {
      element.normalize();
      element.removeAttribute("data-search-highlighted-text");
    });
  }

  function highlightTextNode(textNode: Text, matcher: RegExp) {
    const text = textNode.nodeValue ?? "";
    matcher.lastIndex = 0;
    if (!matcher.test(text)) return;

    matcher.lastIndex = 0;
    const fragment = document.createDocumentFragment();
    let lastIndex = 0;
    let match;

    while ((match = matcher.exec(text)) !== null) {
      if (match.index > lastIndex) {
        fragment.appendChild(document.createTextNode(text.slice(lastIndex, match.index)));
      }

      const mark = document.createElement("mark");
      mark.className = highlightMarkClass;
      mark.textContent = match[0];
      fragment.appendChild(mark);
      lastIndex = match.index + match[0].length;
    }

    if (lastIndex < text.length) {
      fragment.appendChild(document.createTextNode(text.slice(lastIndex)));
    }

    const parent = textNode.parentElement;
    parent?.setAttribute("data-search-highlighted-text", "true");
    textNode.replaceWith(fragment);
  }

  function applySearchHighlights() {
    removeSearchHighlights();
    if (!isPostPage()) return;

    const terms = getHighlightTerms();
    if (terms.length === 0) return;

    const article = document.querySelector("[data-post-scroll-restorable]");
    if (!article) return;

    const matcher = new RegExp(terms.map(escapeRegExp).join("|"), "gi");
    const walker = document.createTreeWalker(article, NodeFilter.SHOW_TEXT, {
      acceptNode(node) {
        if (!node.nodeValue?.trim()) return NodeFilter.FILTER_REJECT;

        const parent = node.parentElement;
        if (!parent || parent.closest(searchHighlightSkipSelector)) {
          return NodeFilter.FILTER_REJECT;
        }

        return NodeFilter.FILTER_ACCEPT;
      },
    });

    const textNodes = [];
    while (walker.nextNode()) {
      textNodes.push(walker.currentNode as Text);
    }

    textNodes.forEach((textNode) => highlightTextNode(textNode, matcher));
  }

  function handleKeyPress(event: KeyboardEvent) {
    if (event.metaKey || event.ctrlKey) return;

    const prevLink = document.querySelector<HTMLAnchorElement>(
      'a[rel="prev"]'
    );
    const nextLink = document.querySelector<HTMLAnchorElement>(
      'a[rel="next"]'
    );

    if (event.key === "ArrowLeft" && prevLink) {
      saveScrollPosition();
      navigate(prevLink.href);
    } else if (event.key === "ArrowRight" && nextLink) {
      saveScrollPosition();
      navigate(nextLink.href);
    }
  }

  if (!postPageState.__postScrollRestorationSetup) {
    postPageState.__postScrollRestorationSetup = true;

    window.addEventListener("keydown", handleKeyPress);
    window.addEventListener("scroll", scheduleScrollPositionSave, { passive: true });
    window.addEventListener("pagehide", saveScrollPosition);
    document.addEventListener("astro:before-preparation", saveScrollPosition);
    document.addEventListener("astro:page-load", () => {
      applySearchHighlights();
      updateHistoryScrollRestoration();
      restoreScrollPosition();
    });
  }

  if (!postPageState.__postSearchHighlightSetup) {
    postPageState.__postSearchHighlightSetup = true;
    document.addEventListener("astro:before-swap", removeSearchHighlights);
    window.addEventListener("pageshow", applySearchHighlights);
  }

  applySearchHighlights();
  updateHistoryScrollRestoration();
  restoreScrollPosition();
</script>

<style lang="scss">
  @use '../styles/variables' as *;

  .title {
    margin-top: 0;
    margin-bottom: $space-xl;
  }

  .meta {
    display: block;
    margin-top: 0;
    margin-bottom: $rhythm;
    font-family: $sans-serif;
    font-size: 0.75 * $base-size;
    font-weight: 700;
    text-transform: uppercase;
    color: $darkgray;
    letter-spacing: 0.02em;
  }

  .divider {
    margin: 0 0 $space-xxs;
    border: none;
    border-top: $layout-rule;
  }

  .backlinks-section {
    margin: $space-xl 0 $space-lg;

    p {
      margin-bottom: $space-xs;
      font-family: $sans-serif;
      font-weight: 700;
    }

    ul {
      margin-top: 0;
      margin-bottom: 0;
    }
  }

  .post-summary {
    margin: $space-xl 0;
    padding: $space-md $space-lg;
    border-left: 3px solid $blue;
    background: rgba($blue, 0.06);

    summary {
      font-family: $sans-serif;
      font-weight: 600;
      cursor: pointer;
    }

    p {
      margin-top: $space-xs;
      margin-bottom: 0;
    }

    .ai-disclaimer {
      margin-top: $space-xxs;
      color: $darkgray;
      font-family: $sans-serif;
      font-size: calc($base-size * 0.75);
    }
  }

  .posts-nav {
    display: flex;
    justify-content: space-between;
    gap: $space-md;
    margin: $space-lg 0 0;
  }

  .post-nav-button {
    display: inline-block;
    min-width: 6.5rem;
    padding: $space-xs $space-md;
    box-sizing: border-box;
    text-align: center;
    border: 1px solid black;
    border-radius: 0.25rem;
    background: black;
    font-family: $sans-serif;
    font-size: calc($base-size * 0.8);
    font-weight: 800;
    color: white;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.25s ease-in-out;

    &:hover {
      background: black;
      border-color: black;
      box-shadow: none;
      color: white;
      opacity: 0.72;
    }

    &.next {
      margin-left: auto;
    }
  }
</style>
