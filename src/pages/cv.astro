            <span class="pill">Technical discovery</span>
            <span class="pill">Enterprise deployment</span>
            <span class="pill">Stakeholder communication</span>
            <span class="pill">Developer docs</span>
          </div>
        </section>

        <section class="side-section">
          <h2>Languages</h2>
          <p class="languages-line">English native · Chinese fluent · German B2</p>
        </section>

        <section class="side-section">
          <h2>Education</h2>
          <article class="education-item">
