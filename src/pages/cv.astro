<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Nick Ang — Product Engineer · AI/Enterprise Integrations</title>
  <style is:global>
    /*
      Editable HTML resume.
      Tip: change text directly in the HTML, then open in Chrome and print/save as PDF.
    */

    :root {
      /* Brand palette sampled from nickang.com/blog screenshot */
      --ink: #111111;
      --muted: #5f5f5f;
      --light: #d9d9d9;
      --accent: #66a9e6;
      --accent-dark: #2f6fa9;
      --accent-soft: #eef7ff;
      --page: #ffffff;
      --bg: #2a1b10;
      --radius: 4px;
    }

    * {
      box-sizing: border-box;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
      font-size: 13px;
      line-height: 1.42;
    }

    .page {
      width: 210mm;
      min-height: 297mm;
      margin: 24px auto;
      background: var(--page);
      box-shadow: 0 14px 40px rgba(17, 17, 17, 0.22);
      padding: 0 17mm 15mm;
      border-left: 4px solid var(--ink);
      border-right: 4px solid var(--ink);
      overflow: hidden;
    }

    header {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 18px;
      padding: 18mm 0 14px;
      border-bottom: 2px solid var(--ink);
      position: relative;
    }

    header::before,
    header::after {
      content: "";
      position: absolute;
      left: -17mm;
      right: -17mm;
    }

    header::before {
      top: 0;
      height: 8px;
      background: var(--accent);
    }

    header::after {
      top: 8px;
      height: 22px;
      background: var(--light);
    }

    header>* {
      position: relative;
      z-index: 1;
    }

    .identity {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .profile-photo {
      width: 92px;
      height: 92px;
      border-radius: 50%;
      object-fit: cover;
      object-position: center 42%;
      transform: scaleX(-1);
      flex: 0 0 auto;
    }

    h1 {
      margin: 0;
      font-size: 34px;
      line-height: 0.95;
      letter-spacing: -1.2px;
    }

    .role {
      margin-top: 7px;
      color: var(--ink);
      font-size: 15.5px;
      font-weight: 800;
      letter-spacing: 0.1px;
      white-space: nowrap;
    }

    .tagline {
      margin-top: 4px;
      color: var(--muted);
      font-weight: 650;
    }

    .contact {
      text-align: right;
      font-size: 11px;
      color: var(--muted);
      line-height: 1.55;
      padding-top: 2px;
      white-space: nowrap;
    }

    a {
      color: inherit;
      text-decoration-line: underline;
      text-decoration-thickness: 0.06em;
      text-underline-offset: 0.14em;
      text-decoration-color: rgba(17, 17, 17, 0.35);
    }

    .contact a {
      color: var(--muted);
      text-decoration-color: rgba(95, 95, 95, 0.35);
    }

    .summary {
      margin: 13px 0 15px;
      padding: 12px 14px;
      background: var(--accent-soft);
      border-left: 5px solid var(--accent);
      border-radius: var(--radius);
      font-size: 12.7px;
    }

    .layout {
      display: grid;
      grid-template-columns: 1fr 58mm;
      gap: 8mm;
      align-items: start;
    }

    h2 {
      margin: 0 0 8px;
      font-size: 12px;
      letter-spacing: 1.4px;
      text-transform: uppercase;
      color: var(--ink);
      border-bottom: 1px solid var(--light);
      padding-bottom: 5px;
    }

    h3 {
      margin: 0;
      font-size: 14px;
      line-height: 1.2;
    }

    .company {
      color: var(--muted);
      font-weight: 700;
    }

    .meta {
      margin-top: 3px;
      color: var(--muted);
      font-size: 11.5px;
      font-weight: 650;
    }

    .context {
      margin: 7px 0 6px;
      color: var(--muted);
      font-size: 11.7px;
      font-style: italic;
    }

    .item {
      margin-bottom: 13px;
      break-inside: avoid;
    }

    .experience-item {
      margin-bottom: 6px;
    }

    .experience-separator {
      margin-bottom: 24px;
    }

    ul {
      margin: 6px 0 0 0;
      padding-left: 0;
      list-style: none;
    }

    li {
      margin: 3px 0;
      position: relative;
      padding-left: 13px;
    }

    li::before {
      content: "•";
      position: absolute;
      left: 0;
      top: 0;
    }

    strong {
      font-weight: 800;
    }

    .quote {
      margin: 10px 0 12px;
      padding: 9px 11px;
      border-left: 3px solid var(--light);
      color: #354056;
      font-size: 11.5px;
      background: #f7f7f7;
      border-radius: var(--radius);
      break-inside: avoid;
    }

    .quote p {
      margin: 0;
    }

    .quote cite {
      display: block;
      margin-top: 5px;
      color: var(--muted);
      font-style: normal;
      font-weight: 700;
    }

    .quote.experience-separator {
      margin-bottom: 24px;
    }

    .layout>aside {
      border-left: 1px solid var(--light);
      padding-left: 5mm;
    }

    .side-section {
      margin-bottom: 15px;
      break-inside: avoid;
    }

    .skills {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      margin-top: 8px;
    }

    .pill {
      display: inline-block;
      padding: 4px 7px;
      border-radius: 999px;
      background: transparent;
      color: #334057;
      border: 1px solid var(--light);
      font-size: 11px;
      font-weight: 650;
    }

    .languages-line {
      margin: 7px 0 0;
      color: var(--muted);
      font-size: 11.4px;
      font-weight: 650;
      line-height: 1.45;
    }

    .education-item {
      margin-bottom: 10px;
    }

    .education-item h3 {
      font-size: 12.5px;
    }

    .education-item p {
      margin: 3px 0 0;
      color: var(--muted);
      font-size: 11.4px;
    }

    .founder-note {
      padding: 10px 11px;
      border-radius: var(--radius);
      background: #ffffff;
      border: 1px solid var(--light);
    }

    @media screen and (max-width: 760px) {
      .page {
        width: calc(100% - 16px);
        min-height: auto;
        margin: 8px auto;
        padding: 0 18px 28px;
        border-left-width: 3px;
        border-right-width: 3px;
      }

      header {
        grid-template-columns: 1fr;
        gap: 10px;
        padding: 56px 0 14px;
      }

      header::before,
      header::after {
        left: -18px;
        right: -18px;
      }

      .identity {
        align-items: flex-start;
      }

      .profile-photo {
        width: 72px;
        height: 72px;
      }

      h1 {
        font-size: 30px;
      }

      .contact {
        text-align: left;
        white-space: normal;
      }

      .layout {
        grid-template-columns: 1fr;
        gap: 18px;
      }

      .layout>aside {
        border-left: 0;
        padding-left: 0;
      }
    }

    @page {
      size: A4;
      margin: 0;
    }

    @media print {

      html,
      body {
        width: 210mm;
        height: 297mm;
        background: white;
      }

      body {
        font-size: 11.3px;
        line-height: 1.28;
      }

      .page {
        width: 210mm;
        height: 297mm;
        min-height: 0;
        margin: 0;
        padding: 0 11mm 9mm;
        box-shadow: none;
        border-left: 3px solid var(--ink);
        border-right: 3px solid var(--ink);
        overflow: hidden;
      }

      header {
        padding: 14mm 0 9px;
        gap: 12px;
      }

      header::before {
        left: -11mm;
        right: -11mm;
        height: 6px;
      }

      header::after {
        left: -11mm;
        right: -11mm;
        top: 6px;
        height: 15px;
      }

      .identity {
        gap: 8px;
      }

      .profile-photo {
        width: 62px;
        height: 62px;
      }

      h1 {
        font-size: 27px;
        letter-spacing: -0.9px;
      }

      .role {
        margin-top: 4px;
        font-size: 13px;
      }

      .tagline {
        margin-top: 2px;
      }

      .contact {
        font-size: 9.5px;
        line-height: 1.35;
      }

      .summary {
        margin: 9px 0 10px;
        padding: 8px 10px;
        border-left-width: 4px;
        font-size: 11.2px;
      }

      .layout {
        grid-template-columns: 1fr 51mm;
        gap: 5mm;
      }

      h2 {
        margin-bottom: 5px;
        font-size: 10.7px;
        letter-spacing: 1.6px;
        padding-bottom: 4px;
      }

      h3 {
        font-size: 12.2px;
      }

      .meta {
        margin-top: 2px;
        font-size: 10.3px;
      }

      .context {
        margin: 4px 0 4px;
        font-size: 10.4px;
      }

      .item {
        margin-bottom: 7px;
        break-inside: avoid;
      }

      .experience-item {
        margin-bottom: 4px;
      }

      .experience-separator {
        margin-bottom: 15px;
      }

      ul {
        margin-top: 4px;
        padding-left: 0;
        list-style: none;
      }

      li {
        margin: 1.5px 0;
        padding-left: 10px;
      }

      .quote {
        margin: 5px 0 7px;
        padding: 6px 8px;
        font-size: 10.2px;
      }

      .quote cite {
        margin-top: 3px;
      }

      .quote.experience-separator {
        margin-bottom: 15px;
      }

      .layout>aside {
        padding-left: 4mm;
      }

      .side-section {
        margin-bottom: 9px;
        break-inside: avoid;
      }

      .founder-note {
        padding: 7px 8px;
        border-radius: var(--radius);
      }

      .skills {
        gap: 3px;
        margin-top: 5px;
      }

      .pill {
        padding: 2px 5px;
        font-size: 9.8px;
        border-radius: 999px;
      }

      .languages-line {
        margin-top: 5px;
        font-size: 10px;
      }

      .education-item {
        margin-bottom: 6px;
      }

      .education-item h3 {
        font-size: 11px;
      }

      .education-item p {
        margin-top: 2px;
        font-size: 10px;
      }

      a {
        color: inherit;
      }
    }
  </style>
</head>

<body>
  <main class="page">
    <header>
      <div class="identity">
        <img class="profile-photo" src="/cv/nick-ang-profile-photo-square-jun-2018-min.jpg" alt="Nick Ang profile photo" />
        <div>
          <h1>Nick Ang</h1>
          <div class="role">Product Engineer · AI & Enterprise Integrations</div>
          <div class="tagline">Fullstack · Client-facing delivery · Founder/operator</div>
        </div>
      </div>
      <div class="contact">
        <a href="https://nickang.com">nickang.com</a><br />
        <a href="https://linkedin.com/in/nickangtc">linkedin.com/in/nickangtc</a><br />
        <a href="https://www.youtube.com/@NickAngHD">youtube.com/@NickAngHD</a><br />
        <a href="/cv/Nick_Ang_Product_Engineer_CV.pdf">Download PDF</a>
