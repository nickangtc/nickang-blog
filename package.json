{
  "name": "nickang-blog",
  "private": false,
  "description": "nickang.com blog powered by Astro and Markdown",
  "version": "2.0.0",
  "author": "Nick Ang",
  "bugs": {
    "url": "https://github.com/nickangtc/nickang-blog/issues"
  },
  "dependencies": {
    "@astrojs/netlify": "^7.0.8",
    "@astrojs/react": "^5.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^6.3.1",
    "astro-pagefind": "^1.8.6",
    "prismjs": "^1.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.99.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "postcss": "^8.5.14",
    "prettier": "^2.2.1"
  },
  "homepage": "https://github.com/nickangtc/nickang-blog",
  "keywords": [
    "astro",
    "blog"
  ],
  "license": "MIT",
  "main": "n/a",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickangtc/nickang-blog.git"
  },
  "scripts": {
    "build": "astro build",
    "dev": "npm run build && astro dev",
    "dev:no-index": "astro dev",
    "format": "prettier --write \"**/*.{js,jsx,json,md,astro}\"",
    "start": "npm run dev",
    "preview": "astro preview",
    "check": "astro check",
    "clean": "rm -rf dist .astro",
    "polish": "node scripts/rename-post-folders-from-title.js && node scripts/auto-internal-links.js && python3 .githooks/normalize-blog-posts.py && node scripts/generate-backlinks.js",
    "images:normalize-orientation": "node scripts/normalize-image-orientation.js",
    "images:normalize-orientation:fix": "node scripts/normalize-image-orientation.js --fix",
    "content:audit-image-captions": "node scripts/audit-image-captions.js",
    "content:fix-image-captions": "node scripts/audit-image-captions.js --fix",
    "content:generate-ai-summaries": "node scripts/generate-ai-summaries.js",
    "content:notify-indexnow": "node scripts/notify-indexnow.js",
    "internal-links": "node scripts/auto-internal-links.js",
    "prepare": "npm run setup-hooks",
    "setup-hooks": "git config core.hooksPath .githooks"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  }
}
